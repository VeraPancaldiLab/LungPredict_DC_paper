df = data.frame(M2_score = as.numeric(counts.norm.log["FOLR2",]), Response = coldata$R.NR)
library(ggpubr)
library(ggplot2)
ggplot(df, aes(x = Response, y = M2_score, fill = Response)) +
geom_boxplot(alpha = 0.6, outlier.shape = NA) +
geom_jitter(width = 0.15, size = 2, alpha = 0.7) +
stat_compare_means(method = "wilcox.test") +
theme_minimal() +
theme(legend.position = "none")
# LP
counts = read.csv("~/Documents/LungPredict_late_stage/data/LPIP/Counts_STAR_RSEM_LP_IP.csv", row.names = 1)
clinical = read.csv("~/Documents/LungPredict_late_stage/data/LPIP/Final_Response_LP_IP.csv", row.names = 1)
m2 <- do.call(rbind, strsplit(rownames(counts), split="_", fixed = TRUE))
counts <- as.matrix(counts)
rownames(counts) = m2[,1]
source("~/Documents/LungPredict_late_stage/scripts/src/utils.R")
counts = compute_ensembl2symbol(data.frame(counts))
counts = ADImpute::NormalizeTPM(counts, log = T)
counts = counts[,colnames(counts) %in% rownames(clinical)]
dim(counts)
counts = counts[,rownames(clinical)]
all.equal(rownames(clinical), colnames(counts))
clinical = clinical %>%
dplyr::filter(Response %in% c("Responders", "Non responders"))
counts = counts[,colnames(counts)%in%rownames(clinical)]
df = data.frame(M2_score = as.numeric(counts["FOLR2",]), Response = clinical$Response)
library(ggpubr)
library(ggplot2)
ggplot(df, aes(x = Response, y = M2_score, fill = Response)) +
geom_boxplot(alpha = 0.6, outlier.shape = NA) +
geom_jitter(width = 0.15, size = 2, alpha = 0.7) +
stat_compare_means(method = "wilcox.test") +
theme_minimal() +
theme(legend.position = "none")
