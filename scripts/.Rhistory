collectri_oct22 <- readRDS(
"/home/marcelo.hurtado/.cache/OmnipathR/099e7af92f71a88d7560d65cea14c1970f66c0b6-1.rds"
)
library(dplyr)
library(stringr)
collectri_processed <- collectri_oct22 %>%
# remove complexes first
{bind_rows(
filter(., !str_detect(source, "COMPLEX")),
filter(., str_detect(source, "COMPLEX")) %>%
mutate(source_genesymbol = case_when(
str_detect(source_genesymbol, "JUN") | str_detect(source_genesymbol, "FOS") ~ "AP1",
str_detect(source_genesymbol, "REL") | str_detect(source_genesymbol, "NFKB") ~ "NFKB",
TRUE ~ source_genesymbol
))
)} %>%
distinct(source_genesymbol, target_genesymbol, .keep_all = TRUE) %>%
mutate(
mor = case_when(is_stimulation == 1 ~ 1,
is_stimulation == 0 ~ -1)
) %>%
select(source = source_genesymbol, target = target_genesymbol, mor)
tfs = scale(compute.TFs.activity(counts.norm.log, universe = collectri_processed))
sig_scores = compute.pathway.activity(t(tfs), gene_sets = genesets)[[2]]
patient_group <- apply(sig_scores, 1, function(x) names(which.max(x)))
clinical$group = patient_group
View(clinical)
table(clinical$group)
res_clusters = compute.survival.analysis(clinical, "PFS", "PFS_bin", file_name = "Patient_groups_Curie",
p.value = 0.05, group_column = "group")
