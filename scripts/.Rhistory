`%||%` <- function(a, b) if (!is.null(a)) a else b
library(jsonlite)
# Load the cache index
cache_index <- fromJSON(file.path(getOption("omnipathr.cachedir"), "cache.json"))
# Each element is a cached object entry — extract info safely
cache_df <- do.call(
rbind,
lapply(names(cache_index), function(nm) {
x <- cache_index[[nm]]
data.frame(
key = nm,
path = x$path %||% NA,
created = x$created %||% NA,
accessed = x$accessed %||% NA,
url = x$url %||% NA,
stringsAsFactors = FALSE
)
})
)
# Show a preview
head(cache_df)
cache_dir <- getOption("omnipathr.cachedir")
cache_files <- list.files(cache_dir, pattern = "\\.rds$", full.names = TRUE)
cache_info <- file.info(cache_files)[, c("mtime", "ctime", "size")]
cache_df2 <- data.frame(
key = gsub("-1\\.rds$", "", basename(cache_files)),
path = cache_files,
modified = cache_info$mtime,
created = cache_info$ctime,
size = cache_info$size,
stringsAsFactors = FALSE
)
# Merge with URLs from your previous table
cache_full <- merge(cache_df2, cache_df, by = "key", all.x = TRUE)
# Sort by modification date
cache_full <- cache_full[order(cache_full$modified, decreasing = TRUE), ]
cache_full[, c("key", "modified", "url")]
