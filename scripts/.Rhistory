library(dplyr)
library(tibble)
library(ggplot2)
source("src/utils.R")
set.seed(123)
pathways_universe = read.csv("../output/Databases/Pathways_collection_PROGENy.csv")
tfs_universe = read.csv("../output/Databases/TF_target_collection.csv")
counts = read.delim("~/Documents/LungPredict_late_stage/data/Captier/TIPIT_RNA_TPM_134.txt")
clinical = read.delim("~/Documents/LungPredict_late_stage/data/Captier/TIPIT_reponse_134.txt")
counts = counts %>%
dplyr::select(-GeneID) %>%
dplyr::distinct(gene_name, .keep_all = T) %>%
tibble::column_to_rownames("gene_name")
clinical = clinical %>%
dplyr::mutate(Batch = as.numeric(counts[1,])) %>%
tibble::column_to_rownames("patient_ID")
counts = counts[-1,rownames(clinical)]
counts.norm.log = log(counts + 1)
genesets = readRDS("Results/group_marker_genesets.rds")
tfs = compute.TFs.activity(counts.norm.log, TF.collection = "ARACNE", file.name = "CurieImmuno_ARACNE") #Network is ../output/TF_network_ARACNE.txt
sig_scores = compute.pathway.activity(t(tfs), paths = pathways_universe, gene_sets = genesets, file.name = "CurieImmuno_ARACNE")[[2]]
patient_group <- apply(sig_scores, 1, function(x) names(which.max(x)))
clinical$group = patient_group
res_clusters = compute.survival.analysis(clinical, "PFS", "PFS_bin", file_name = "Validation_Curie_PFS",
p.value = 0.05, group_column = "group")
mega_clusters = read.csv("../input/raw_files/Table_mega_cluster_mm2.csv")
entropy_clusters = read.csv("../input/raw_files/table_entropy_mega_cluster.csv") %>%
dplyr::filter(Spatial_cluster != "cDC1+")
