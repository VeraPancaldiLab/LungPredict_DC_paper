)
dc_signatures_score = compute.pathway.activity(counts.norm.log, gene_sets = gene_sets)[[2]]
compute.modules.relationship(dc_signatures_score, spatial_data, file_name = "Pathways-spatial", width = 10, height = 7)
compute.modules.relationship(dc_signatures_score, data_spatial, file_name = "Pathways-spatial", width = 10, height = 7)
compute.modules.relationship(dc_signatures_score, data_spatial, file_name = "Pathways-spatial", width = 15, height = 7)
