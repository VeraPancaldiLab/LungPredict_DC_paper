sig = c(sig, j)
}
}
cell.groups.sig = list()
if (length(sig) == 0) {
message("No significant cell groups (p-value < ", pval, ") after ANOVA test")
return(NULL)
} else {
cell.groups.sig[[1]] = cell.groups[[1]][, sig, drop = FALSE]
cell.groups.sig[[2]] = cell.groups[[2]][sig]
cell.groups.sig[[3]] = cell.groups[[3]][sig]
return(cell.groups.sig)
}
}
anova = cell.groups.anova.test(cell_groups, coldata, "Groups", pval = 0.05)
anova = cell.groups.anova.test(cell_groups, coldata, "Groups", pval = 0.05)
anova
View(anova)
anova[[2]]
coldata_subset = coldata %>% dplyr::filter(Groups %in% c(2,4))
View(coldata_subset)
cell_groups[[1]] = cell_groups[[1]][rownames(cell_groups[[1]])%in%rownames(coldata_subset),]
View(cell_groups)
anova = cell.groups.anova.test(cell_groups, coldata, "Groups", pval = 0.05)
anova = cell.groups.anova.test(cell_groups, coldata_subset, "Groups", pval = 0.05)
coldata_subset$Groups
coldata_subset$Groups <- droplevels(coldata_subset$Groups)
coldata_subset$Groups
anova = cell.groups.anova.test(cell_groups, coldata_subset, "Groups", pval = 0.05)
