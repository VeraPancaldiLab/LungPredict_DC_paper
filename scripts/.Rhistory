palette = c("#E7B800", "#2E9FDF"),
conf.int.style = "step",
pval = TRUE,
risk.table = TRUE,
risk.table.col = "strata",
legend.labs = c("High", "Low"),
risk.table.height = 0.3,
ggtheme = theme_grey(),
title = paste0("Cox PH for ", names(significant_combinations)[contador]),
xlab = "Time to death/recurrence/progression")
)
dev.off()
contador = contador + 1
}
}
}
if (length(significant_combinations) == 0) {
print("No significant combinations found.")
} else {
return(significant_combinations)
}
}
res_models = compute.survival.models(data_spatial$Stroma, survival.data = traitData,"PFS", "PFS_event", file_name = "Stroma", max_factors = 1)
View(res_models)
